/* Hard mobile repair layer: index scroll, ayah actions, developer card, readable phone UI */
:root{--qma-hard-radius:22px}
html,body{max-width:100%;overflow-x:hidden!important;}
body.qma-body{min-height:100dvh;-webkit-text-size-adjust:100%;}
body.qma-sheet-open{overflow:hidden!important;position:static!important;height:100dvh!important;touch-action:none!important;}
body.qma-sheet-open .qma-index-body{touch-action:pan-y!important;}

/* Mushaf text repair */
.qma-mushaf-page{overflow:visible!important;}
.qma-mushaf-text{direction:rtl!important;text-align:justify!important;text-align-last:center!important;word-break:normal!important;overflow-wrap:normal!important;white-space:normal!important;font-family:"Noto Naskh Arabic","Amiri Quran","Amiri","Scheherazade New","Traditional Arabic","Times New Roman",serif!important;}
.qma-ayah-inline.qma-ayah-clickable{display:inline!important;cursor:pointer!important;pointer-events:auto!important;border-radius:12px!important;padding:0 .015em!important;touch-action:manipulation!important;-webkit-tap-highlight-color:rgba(15,124,97,.16)!important;}
.qma-ayah-inline.qma-ayah-clickable:active,.qma-ayah-inline.qma-ayah-clickable.is-selected{background:rgba(15,124,97,.15)!important;box-shadow:0 0 0 5px rgba(15,124,97,.08)!important;}
.qma-ayah-number{pointer-events:none!important;user-select:none!important;}

/* Strong index modal */
.qma-index-backdrop{position:fixed!important;inset:0!important;z-index:99990!important;background:rgba(15,16,14,.58)!important;backdrop-filter:blur(7px)!important;-webkit-backdrop-filter:blur(7px)!important;display:flex!important;align-items:flex-end!important;justify-content:center!important;overflow:hidden!important;padding:0!important;touch-action:none!important;}
.qma-index-sheet{width:100%!important;max-width:760px!important;height:calc(100dvh - env(safe-area-inset-top) - 8px)!important;max-height:calc(100dvh - env(safe-area-inset-top) - 8px)!important;margin:0 auto!important;background:var(--surface,#fffdf6)!important;border:1px solid var(--line,rgba(0,0,0,.08))!important;border-bottom:0!important;border-radius:30px 30px 0 0!important;box-shadow:0 -24px 80px rgba(0,0,0,.25)!important;display:grid!important;grid-template-rows:auto auto auto minmax(0,1fr) auto!important;overflow:hidden!important;padding:0!important;box-sizing:border-box!important;direction:rtl!important;}
.qma-index-head{display:grid!important;grid-template-columns:54px 1fr 54px!important;align-items:center!important;gap:8px!important;padding:16px 18px 10px!important;background:var(--surface,#fffdf6)!important;position:relative!important;z-index:3!important;}
.qma-index-head h2{grid-column:2!important;margin:0!important;text-align:center!important;color:var(--brand-2,#075e47)!important;font-size:clamp(1.7rem,6.6vw,2.3rem)!important;font-weight:1000!important;line-height:1.2!important;}
.qma-index-close{grid-column:1!important;grid-row:1!important;width:52px!important;height:52px!important;border:0!important;border-radius:18px!important;background:#efede7!important;color:#20251f!important;font-size:2rem!important;font-weight:400!important;line-height:1!important;display:grid!important;place-items:center!important;box-shadow:none!important;}
.qma-index-search{height:54px!important;margin:0 18px 12px!important;border-radius:18px!important;background:rgba(255,255,255,.92)!important;border:1px solid var(--line,rgba(0,0,0,.08))!important;display:flex!important;align-items:center!important;gap:10px!important;padding:0 16px!important;box-sizing:border-box!important;box-shadow:0 7px 18px rgba(0,0,0,.04)!important;}
.qma-index-search input{width:100%!important;min-width:0!important;height:100%!important;border:0!important;outline:0!important;background:transparent!important;color:var(--ink,#111)!important;text-align:right!important;font-size:1rem!important;font-weight:800!important;}
.qma-index-search input::placeholder{color:#80827e!important;opacity:1!important;}
.qma-index-search span{order:-1!important;color:var(--brand-2,#075e47)!important;font-size:1.35rem!important;font-weight:900!important;}
.qma-index-tabs{height:56px!important;margin:0 18px 12px!important;padding:5px!important;border-radius:18px!important;background:#f0eee8!important;border:1px solid rgba(0,0,0,.04)!important;display:grid!important;grid-template-columns:repeat(3,minmax(0,1fr))!important;gap:5px!important;box-sizing:border-box!important;}
.qma-index-tabs button{height:44px!important;border:0!important;border-radius:14px!important;background:transparent!important;color:#777b75!important;font-size:.95rem!important;font-weight:1000!important;white-space:nowrap!important;overflow:hidden!important;text-overflow:ellipsis!important;min-width:0!important;padding:0 6px!important;}
.qma-index-tabs button.is-active{background:var(--brand-2,#075e47)!important;color:#fff!important;box-shadow:0 8px 18px rgba(7,94,71,.18)!important;}
.qma-index-body{min-height:0!important;height:100%!important;max-height:none!important;overflow-y:auto!important;overflow-x:hidden!important;-webkit-overflow-scrolling:touch!important;overscroll-behavior:contain!important;touch-action:pan-y!important;padding:0 18px 14px!important;box-sizing:border-box!important;scrollbar-width:thin!important;}
.qma-index-body::-webkit-scrollbar{width:7px!important;}
.qma-index-body::-webkit-scrollbar-thumb{background:rgba(7,94,71,.35)!important;border-radius:999px!important;}
.qma-index-group{margin:0 0 12px!important;}
.qma-index-group h3{position:sticky!important;top:0!important;z-index:2!important;margin:0 0 9px!important;padding:9px 13px!important;border-radius:14px!important;background:color-mix(in srgb,var(--surface,#fffdf6) 94%,transparent)!important;color:var(--brand-2,#075e47)!important;font-size:1rem!important;font-weight:1000!important;text-align:right!important;border-inline-end:5px solid var(--brand-2,#075e47)!important;box-shadow:0 8px 18px rgba(0,0,0,.04)!important;}
.qma-index-row,.qma-juz-row{width:100%!important;min-height:74px!important;border:1px solid var(--line,rgba(0,0,0,.08))!important;border-radius:20px!important;background:rgba(255,255,255,.78)!important;box-shadow:0 9px 20px rgba(17,38,30,.06)!important;margin:0 0 10px!important;padding:10px 12px!important;box-sizing:border-box!important;color:var(--ink,#111)!important;display:grid!important;align-items:center!important;gap:10px!important;overflow:hidden!important;}
.qma-index-row{grid-template-columns:50px minmax(0,1fr) 54px!important;}
.qma-juz-row{grid-template-columns:minmax(0,1fr) auto!important;text-align:right!important;}
.qma-index-row.is-active{background:var(--brand-2,#075e47)!important;color:#fff!important;border-color:var(--brand-2,#075e47)!important;box-shadow:0 12px 28px rgba(7,94,71,.24)!important;}
.qma-index-num,.qma-index-page{width:46px!important;height:46px!important;border-radius:16px!important;display:grid!important;place-items:center!important;background:var(--brand-soft,#e6f4ef)!important;color:var(--brand-2,#075e47)!important;font-weight:1000!important;font-size:.92rem!important;}
.qma-index-row.is-active .qma-index-num,.qma-index-row.is-active .qma-index-page{background:rgba(255,255,255,.18)!important;color:#fff!important;}
.qma-index-row strong{min-width:0!important;display:grid!important;gap:4px!important;text-align:right!important;font-size:1.06rem!important;font-weight:1000!important;line-height:1.25!important;}
.qma-index-row small{display:block!important;color:var(--muted,#777)!important;font-size:.8rem!important;font-weight:800!important;line-height:1.35!important;white-space:nowrap!important;overflow:hidden!important;text-overflow:ellipsis!important;}
.qma-index-row.is-active small{color:rgba(255,255,255,.74)!important;}
.qma-index-foot{padding:10px 16px calc(10px + env(safe-area-inset-bottom))!important;background:var(--surface,#fffdf6)!important;color:var(--muted,#777)!important;font-size:.78rem!important;font-weight:800!important;line-height:1.6!important;text-align:center!important;border-top:1px solid var(--line,rgba(0,0,0,.08))!important;}

/* Ayah action sheet */
.qma-ayah-actions-backdrop{position:fixed!important;inset:0!important;z-index:100500!important;background:rgba(15,15,13,.55)!important;display:flex!important;align-items:flex-end!important;justify-content:center!important;padding:14px!important;box-sizing:border-box!important;backdrop-filter:blur(6px)!important;-webkit-backdrop-filter:blur(6px)!important;}
.qma-ayah-actions--hard{width:min(100%,560px)!important;background:var(--surface,#fff)!important;color:var(--ink,#111)!important;border:1px solid var(--line,rgba(0,0,0,.08))!important;border-radius:28px 28px 20px 20px!important;box-shadow:0 24px 70px rgba(0,0,0,.30)!important;padding:14px 14px calc(16px + env(safe-area-inset-bottom))!important;direction:rtl!important;box-sizing:border-box!important;}
.qma-ayah-actions--hard header{display:grid!important;grid-template-columns:48px 1fr!important;gap:8px!important;align-items:center!important;margin-bottom:10px!important;}
.qma-ayah-actions--hard header button{width:46px!important;height:46px!important;border:0!important;border-radius:16px!important;background:#efede7!important;color:#222!important;font-size:1.8rem!important;line-height:1!important;}
.qma-ayah-actions--hard h3{margin:0!important;color:var(--brand-2,#075e47)!important;font-size:1.12rem!important;font-weight:1000!important;line-height:1.4!important;text-align:right!important;}
.qma-ayah-actions--hard p{margin:0 0 14px!important;max-height:180px!important;overflow:auto!important;background:var(--brand-soft,#e6f4ef)!important;border-radius:18px!important;padding:12px 14px!important;font-family:"Noto Naskh Arabic","Amiri","Scheherazade New","Traditional Arabic",serif!important;font-size:1.32rem!important;line-height:2.05!important;text-align:right!important;color:var(--ink,#111)!important;}
.qma-ayah-actions-grid{display:grid!important;grid-template-columns:repeat(2,minmax(0,1fr))!important;gap:10px!important;}
.qma-ayah-actions-grid button{min-height:50px!important;border:0!important;border-radius:16px!important;background:#f2f0ea!important;color:var(--ink,#111)!important;font-weight:1000!important;font-size:.98rem!important;padding:8px 10px!important;}
.qma-ayah-actions-grid button.is-primary{background:var(--brand-2,#075e47)!important;color:#fff!important;}

/* Developer card */
.qma-developer-card{margin:22px auto calc(105px + env(safe-area-inset-bottom))!important;padding:22px 16px!important;border-radius:24px!important;background:linear-gradient(180deg,rgba(255,255,255,.76),rgba(255,255,255,.46))!important;border:1px solid var(--line,rgba(0,0,0,.08))!important;box-shadow:0 10px 26px rgba(17,38,30,.07)!important;text-align:center!important;direction:ltr!important;color:var(--ink,#111)!important;}
.qma-developer-card p{margin:0 0 8px!important;color:var(--brand-2,#075e47)!important;font-weight:1000!important;direction:rtl!important;}
.qma-developer-card h2{margin:0 0 12px!important;color:var(--brand,#0f8b68)!important;font-size:1.05rem!important;font-weight:1000!important;}
.qma-developer-card a{display:block!important;color:var(--ink,#111)!important;text-decoration:none!important;font-weight:1000!important;margin-top:10px!important;overflow-wrap:anywhere!important;}
.qma-toast-hard{position:fixed!important;left:50%!important;bottom:calc(105px + env(safe-area-inset-bottom))!important;transform:translateX(-50%)!important;z-index:110000!important;max-width:calc(100% - 32px)!important;background:#171a17!important;color:#fff!important;border-radius:999px!important;padding:12px 16px!important;box-shadow:0 18px 45px rgba(0,0,0,.28)!important;font-weight:900!important;text-align:center!important;line-height:1.5!important;}

@media(max-width:520px){
  .qma-index-sheet{height:calc(100dvh - env(safe-area-inset-top) - 4px)!important;max-height:calc(100dvh - env(safe-area-inset-top) - 4px)!important;border-radius:26px 26px 0 0!important;}
  .qma-index-head{padding:14px 14px 8px!important;grid-template-columns:50px 1fr 50px!important;}
  .qma-index-close{width:48px!important;height:48px!important;border-radius:16px!important;}
  .qma-index-head h2{font-size:1.62rem!important;}
  .qma-index-search,.qma-index-tabs{margin-left:14px!important;margin-right:14px!important;}
  .qma-index-body{padding-left:14px!important;padding-right:14px!important;}
  .qma-index-row{grid-template-columns:46px minmax(0,1fr) 48px!important;min-height:70px!important;border-radius:18px!important;padding:9px 9px!important;}
  .qma-index-num,.qma-index-page{width:42px!important;height:42px!important;border-radius:14px!important;font-size:.84rem!important;}
  .qma-index-row strong{font-size:1rem!important;}
  .qma-index-row small{font-size:.76rem!important;}
  .qma-ayah-actions-grid{gap:8px!important;}
  .qma-ayah-actions-grid button{min-height:48px!important;font-size:.94rem!important;}
  .qma-ayah-actions--hard p{font-size:1.22rem!important;}
}
@media(max-width:360px){
  .qma-index-tabs button{font-size:.78rem!important;padding:0 3px!important;}
  .qma-index-row{grid-template-columns:42px minmax(0,1fr) 44px!important;}
  .qma-index-num,.qma-index-page{width:38px!important;height:38px!important;}
  .qma-ayah-actions-grid{grid-template-columns:1fr!important;}
}
