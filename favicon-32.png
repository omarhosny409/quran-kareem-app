/* V17 critical repair: mobile layout, reader mode, ayah actions, search, index scroll */
:root{--qma-bottom-safe:env(safe-area-inset-bottom,0px);--qma-panel-space:190px;}
html[data-qma-v17="critical"]{scroll-behavior:smooth;}
html[data-qma-v17="critical"] body{overscroll-behavior-y:contain;}
html[data-qma-v17="critical"] .qma-app--mushaf{padding-bottom:calc(var(--qma-panel-space) + var(--qma-bottom-safe))!important;}
html[data-qma-v17="critical"] .qma-mushaf-stage{padding-bottom:calc(var(--qma-panel-space) + 12px)!important;}
html[data-qma-v17="critical"] .qma-mushaf-page{padding:14px 6px calc(var(--qma-panel-space) + 18px)!important;min-height:calc(100svh - 60px)!important;overflow:visible!important;}
html[data-qma-v17="critical"] .qma-mushaf-text{
  font-family:"Traditional Arabic","Amiri","Scheherazade New","Noto Naskh Arabic","Times New Roman",serif!important;
  font-size:calc(clamp(2.05rem,8.4vw,3.15rem)*var(--font-scale-app,1))!important;
  line-height:1.78!important;
  text-align:center!important;
  text-align-last:auto!important;
  word-spacing:.025em!important;
  letter-spacing:0!important;
  user-select:none!important;-webkit-user-select:none!important;-webkit-touch-callout:none!important;
  overflow-wrap:normal!important;hyphens:none!important;
}
html[data-qma-v17="critical"] .qma-ayah-inline{display:inline!important;position:relative!important;border-radius:12px!important;cursor:pointer!important;touch-action:pan-y!important;-webkit-tap-highlight-color:rgba(7,94,71,.16)!important;user-select:none!important;-webkit-user-select:none!important;-webkit-touch-callout:none!important;}
html[data-qma-v17="critical"] .qma-ayah-inline.is-selected,
html[data-qma-v17="critical"] .qma-ayah-inline.qma-search-focus-ayah{background:rgba(7,94,71,.13)!important;box-shadow:0 0 0 5px rgba(7,94,71,.07)!important;}
html[data-qma-v17="critical"] .qma-ayah-number{display:inline-grid!important;place-items:center!important;min-width:1.55em!important;width:1.55em!important;height:1.55em!important;margin:0 .12em!important;border:2px solid #b99b45!important;border-radius:999px!important;color:#0f7a5f!important;background:#fff9e8!important;font-family:Tahoma,Arial,sans-serif!important;font-size:.40em!important;font-weight:900!important;line-height:1!important;vertical-align:middle!important;white-space:nowrap!important;}
html[data-qma-v17="critical"] .qma-surah-break{margin:6px auto 8px!important;padding:7px 18px!important;font-size:.98rem!important;}
html[data-qma-v17="critical"] .qma-basmala{font-size:calc(clamp(1.6rem,6.2vw,2.25rem)*var(--font-scale-app,1))!important;line-height:1.65!important;margin:4px auto 6px!important;}
html[data-qma-v17="critical"] .qma-reader-actions{position:fixed!important;left:18px!important;right:auto!important;bottom:calc(170px + var(--qma-bottom-safe))!important;z-index:54!important;display:flex!important;gap:8px!important;pointer-events:auto!important;}
html[data-qma-v17="critical"] .qma-reader-actions button{width:52px!important;height:52px!important;border-radius:999px!important;font-size:0!important;display:grid!important;place-items:center!important;box-shadow:0 10px 25px rgba(0,0,0,.18)!important;}
html[data-qma-v17="critical"] .qma-svg-icon{width:23px;height:23px;display:block;}
html[data-qma-v17="critical"] .qma-reader-panel{position:fixed!important;left:14px!important;right:14px!important;bottom:calc(86px + var(--qma-bottom-safe))!important;width:auto!important;z-index:52!important;padding:12px 14px!important;border-radius:24px!important;}
html[data-qma-v17="critical"] .qma-bottom-nav{position:fixed!important;left:14px!important;right:14px!important;bottom:calc(10px + var(--qma-bottom-safe))!important;width:auto!important;z-index:53!important;}
html[data-qma-v17="critical"] .qma-topbar{z-index:60!important;}

/* Clean reader mode */
html[data-qma-v17="critical"] body.qma-reader-clean-v17 .qma-topbar,
html[data-qma-v17="critical"] body.qma-reader-clean-v17 .qma-mushaf-mini-title,
html[data-qma-v17="critical"] body.qma-reader-clean-v17 .qma-reader-actions,
html[data-qma-v17="critical"] body.qma-reader-clean-v17 .qma-reader-panel,
html[data-qma-v17="critical"] body.qma-reader-clean-v17 .qma-bottom-nav,
html[data-qma-v17="critical"] body.qma-reader-clean-v17 .qma-connectivity-badge{display:none!important;}
html[data-qma-v17="critical"] body.qma-reader-clean-v17 .qma-app--mushaf{padding:8px 8px calc(28px + var(--qma-bottom-safe))!important;}
html[data-qma-v17="critical"] body.qma-reader-clean-v17 .qma-mushaf-stage{padding-bottom:0!important;}
html[data-qma-v17="critical"] body.qma-reader-clean-v17 .qma-mushaf-page{padding:10px 6px 36px!important;min-height:100svh!important;}
html[data-qma-v17="critical"] body.qma-reader-clean-v17 .qma-mushaf-text{font-size:calc(clamp(2.05rem,8.7vw,3.25rem)*var(--font-scale-app,1))!important;line-height:1.76!important;}
#qma-reader-clean-exit-v17{position:fixed;top:calc(12px + env(safe-area-inset-top,0px));left:12px;z-index:9999;border:0;border-radius:999px;background:#075e47;color:#fff;padding:10px 14px;display:flex;align-items:center;gap:7px;font-weight:900;box-shadow:0 10px 28px rgba(0,0,0,.18)}
#qma-reader-clean-exit-v17 svg{width:18px;height:18px;}

/* Ayah actions */
.qma-ayah-actions-backdrop-v17{position:fixed;inset:0;z-index:100000;background:rgba(15,16,14,.48);backdrop-filter:blur(8px);-webkit-backdrop-filter:blur(8px);display:flex;align-items:flex-end;justify-content:center;padding:0 12px calc(12px + env(safe-area-inset-bottom,0px));box-sizing:border-box;}
.qma-ayah-actions-v17{width:min(100%,560px);background:var(--surface,#fffdf6);color:var(--ink,#101510);border:1px solid var(--line,rgba(0,0,0,.08));border-radius:28px 28px 22px 22px;box-shadow:0 -22px 60px rgba(0,0,0,.25);padding:16px;box-sizing:border-box;direction:rtl;}
.qma-ayah-actions-v17 header{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:10px;}
.qma-ayah-actions-v17 h3{margin:0;color:var(--brand-2,#075e47);font-size:1.1rem;font-weight:1000;}
.qma-ayah-actions-v17 .qma-close{width:44px;height:44px;border:0;border-radius:15px;background:#efede7;color:#111;font-size:1.8rem;line-height:1;}
.qma-ayah-actions-v17 p{margin:0 0 14px;padding:12px;border-radius:18px;background:rgba(7,94,71,.06);font-family:"Traditional Arabic","Amiri","Times New Roman",serif;font-size:1.6rem;line-height:1.8;text-align:center;max-height:180px;overflow:auto;}
.qma-ayah-actions-grid-v17{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;}
.qma-ayah-actions-grid-v17 button{border:1px solid var(--line,rgba(0,0,0,.08));border-radius:16px;background:#fff;color:#17231d;min-height:48px;font-weight:900;font-size:.95rem;}
.qma-ayah-actions-grid-v17 button.is-primary{background:var(--brand-2,#075e47);color:#fff;border-color:var(--brand-2,#075e47);}
@media(max-width:380px){.qma-ayah-actions-grid-v17{grid-template-columns:repeat(2,1fr)}.qma-ayah-actions-v17 p{font-size:1.35rem}}

/* Search */
.qma-search-result-v17{width:100%;border:1px solid var(--line,rgba(0,0,0,.08));border-radius:18px;background:var(--surface,#fff);box-shadow:var(--shadow-soft,0 8px 18px rgba(0,0,0,.06));padding:14px 16px;margin:10px 0;text-align:right;color:var(--ink,#111);font:inherit;display:block;}
.qma-search-result-v17 strong{display:block;color:var(--brand-2,#075e47);font-weight:1000;font-size:1.08rem;margin-bottom:4px;}
.qma-search-result-v17 span{display:block;color:var(--muted,#777);font-size:.84rem;font-weight:800;margin-bottom:8px;}
.qma-search-result-v17 p{margin:0;line-height:1.85;font-size:1.02rem;}
.qma-search-result-v17 mark{background:#fff1a8;border-radius:7px;padding:0 3px;color:inherit;}
.qma-search-result-v17.is-loading{opacity:.65;pointer-events:none;}

/* Index sheet scroll and cleaner mobile layout */
html[data-qma-v17="critical"] .qma-index-backdrop{z-index:99990!important;overflow:hidden!important;touch-action:none!important;background:rgba(15,16,14,.52)!important;backdrop-filter:blur(8px)!important;-webkit-backdrop-filter:blur(8px)!important;}
html[data-qma-v17="critical"] .qma-index-sheet{height:calc(100dvh - env(safe-area-inset-top,0px) - 8px)!important;max-height:calc(100dvh - env(safe-area-inset-top,0px) - 8px)!important;width:100%!important;max-width:620px!important;display:grid!important;grid-template-rows:auto auto auto minmax(0,1fr) auto!important;overflow:hidden!important;padding:0!important;border-radius:30px 30px 0 0!important;background:var(--surface,#fffdf6)!important;}
html[data-qma-v17="critical"] .qma-index-head{padding:16px 18px 8px!important;display:grid!important;grid-template-columns:54px 1fr 54px!important;}
html[data-qma-v17="critical"] .qma-index-head h2{grid-column:2!important;text-align:center!important;font-size:1.85rem!important;}
html[data-qma-v17="critical"] .qma-index-search{height:54px!important;margin:0 18px 10px!important;padding:0 16px!important;border-radius:18px!important;}
html[data-qma-v17="critical"] .qma-index-tabs{height:55px!important;margin:0 18px 10px!important;}
html[data-qma-v17="critical"] .qma-index-body{min-height:0!important;overflow-y:auto!important;overflow-x:hidden!important;-webkit-overflow-scrolling:touch!important;overscroll-behavior:contain!important;touch-action:pan-y!important;padding:0 18px calc(18px + env(safe-area-inset-bottom,0px))!important;}
html[data-qma-v17="critical"] .qma-index-body::-webkit-scrollbar{width:7px!important;}html[data-qma-v17="critical"] .qma-index-body::-webkit-scrollbar-thumb{background:rgba(7,94,71,.35)!important;border-radius:999px!important;}
html[data-qma-v17="critical"] .qma-index-group h3{position:sticky!important;top:0!important;z-index:2!important;background:color-mix(in srgb,var(--surface,#fffdf6) 94%,transparent)!important;margin:0 0 8px!important;border-radius:14px!important;padding:9px 12px!important;box-shadow:0 7px 18px rgba(0,0,0,.04)!important;}
html[data-qma-v17="critical"] .qma-index-row,
html[data-qma-v17="critical"] .qma-juz-row{min-height:70px!important;border-radius:18px!important;margin:0 0 9px!important;padding:10px 12px!important;background:rgba(255,255,255,.94)!important;}
html[data-qma-v17="critical"] .qma-index-foot{display:none!important;}
@media(max-width:430px){html[data-qma-v17="critical"] .qma-topbar{gap:5px!important;padding:8px!important}html[data-qma-v17="critical"] .qma-topbar .qma-icon-btn{min-width:42px!important;height:42px!important;border-radius:14px!important}html[data-qma-v17="critical"] .qma-top-search{height:42px!important;padding:0 10px!important}html[data-qma-v17="critical"] .qma-mushaf-text{font-size:calc(clamp(1.92rem,8.7vw,2.75rem)*var(--font-scale-app,1))!important;line-height:1.72!important}.qma-ayah-actions-grid-v17 button{font-size:.86rem;min-height:46px}html[data-qma-v17="critical"] .qma-reader-actions{left:14px!important;bottom:calc(166px + var(--qma-bottom-safe))!important}html[data-qma-v17="critical"] .qma-reader-actions button{width:48px!important;height:48px!important}}
