html[data-qma-v16="qma-v16-reader-search-fixed"] .qma-search-result-v16{
  width:100%;border:0;text-align:right;cursor:pointer;display:block;color:inherit;background:rgba(255,255,255,.96);
}
html[data-qma-v16="qma-v16-reader-search-fixed"] .qma-search-result-v16 span{display:block;color:#7a817c;font-weight:800;margin-top:3px;font-size:.88rem;}
html[data-qma-v16="qma-v16-reader-search-fixed"] .qma-search-result-v16.is-loading{opacity:.65;pointer-events:none;}
html[data-qma-v16="qma-v16-reader-search-fixed"] .qma-search-focus-ayah{
  background:rgba(15,139,104,.14)!important;border-radius:14px;box-shadow:0 0 0 8px rgba(15,139,104,.10);transition:background .25s,box-shadow .25s;
}
html[data-qma-v16="qma-v16-reader-search-fixed"] .qma-toast-v16{
  position:fixed;left:50%;bottom:calc(96px + env(safe-area-inset-bottom));transform:translateX(-50%);z-index:9999;
  background:#0a5d47;color:#fff;border-radius:999px;padding:12px 18px;font-weight:900;box-shadow:0 16px 34px rgba(0,0,0,.22);max-width:calc(100vw - 36px);text-align:center;
}
html[data-qma-v16="qma-v16-reader-search-fixed"] .qma-mushaf-text,
html[data-qma-v16="qma-v16-reader-search-fixed"] .qma-mushaf-text *{
  -webkit-user-select:none!important;user-select:none!important;-webkit-touch-callout:none!important;
}
html[data-qma-v16="qma-v16-reader-search-fixed"] body.qma-reader-clean-v16{overflow:auto!important;background:#fbf3df!important;}
html[data-qma-v16="qma-v16-reader-search-fixed"] body.qma-reader-clean-v16 .qma-topbar,
html[data-qma-v16="qma-v16-reader-search-fixed"] body.qma-reader-clean-v16 .qma-mushaf-mini-title,
html[data-qma-v16="qma-v16-reader-search-fixed"] body.qma-reader-clean-v16 .qma-reader-panel,
html[data-qma-v16="qma-v16-reader-search-fixed"] body.qma-reader-clean-v16 .qma-reader-actions,
html[data-qma-v16="qma-v16-reader-search-fixed"] body.qma-reader-clean-v16 .qma-bottom-nav,
html[data-qma-v16="qma-v16-reader-search-fixed"] body.qma-reader-clean-v16 .qma-connectivity-badge{display:none!important;}
html[data-qma-v16="qma-v16-reader-search-fixed"] body.qma-reader-clean-v16 .qma-app--mushaf{
  padding:calc(10px + env(safe-area-inset-top)) 12px calc(18px + env(safe-area-inset-bottom))!important;max-width:780px!important;
}
html[data-qma-v16="qma-v16-reader-search-fixed"] body.qma-reader-clean-v16 .qma-mushaf-page{
  padding-bottom:22px!important;min-height:auto!important;
}
html[data-qma-v16="qma-v16-reader-search-fixed"] body.qma-reader-clean-v16 .qma-mushaf-meta{margin-top:0!important;padding-top:2px!important;}
html[data-qma-v16="qma-v16-reader-search-fixed"] body.qma-reader-clean-v16 .qma-mushaf-text{
  font-size:calc(clamp(2rem,9.2vw,3.15rem)*var(--font-scale-app,1))!important;line-height:2.02!important;word-spacing:.035em!important;
}
#qma-reader-clean-exit{
  position:fixed;top:calc(12px + env(safe-area-inset-top));left:12px;z-index:9900;border:0;border-radius:999px;background:rgba(255,255,255,.94);
  color:#075e47;display:flex;align-items:center;gap:6px;padding:9px 12px;font-weight:1000;box-shadow:0 10px 26px rgba(0,0,0,.16);font-family:inherit;
}
#qma-reader-clean-exit svg{width:18px;height:18px;}
@media(max-width:560px){
  html[data-qma-v16="qma-v16-reader-search-fixed"] body.qma-reader-clean-v16 .qma-mushaf-text{line-height:1.96!important;font-size:calc(clamp(1.86rem,8.8vw,2.75rem)*var(--font-scale-app,1))!important;}
  html[data-qma-v16="qma-v16-reader-search-fixed"] body.qma-reader-clean-v16 .qma-app--mushaf{padding-inline:8px!important;}
  html[data-qma-v16="qma-v16-reader-search-fixed"] .qma-search-result-v16{border-radius:18px!important;padding:15px 16px!important;}
}
